# =============================================================================
# AlgoTrade MT5 — Dashboard Environment Variables
# =============================================================================
# Copy this file to .env and adjust as needed.
# The dashboard reads these at startup. The bot does NOT read this file
# (the bot uses config.yaml for its settings).
#
# Usage:
#   cp .env.example .env
#   # edit .env with your values
#   source .env && ./start.sh
# =============================================================================

# Path to the bot's state JSON file.
# The dashboard reads this file to display live data. Must match the path
# the bot writes to (default is state.json in the bot directory).
BOT_STATE_FILE=/home/team/shared/bot/state.json

# Port the dashboard web server listens on.
# Default: 3000. This is the only publicly exposed port.
DASHBOARD_PORT=3000

# Bind address for the dashboard web server.
# Use "0.0.0.0" to accept connections from any network interface
# (required for remote access). Use "127.0.0.1" for local-only access.
DASHBOARD_HOST=0.0.0.0

# Maximum age (in seconds) of the state.json file before the dashboard
# shows a "data may be stale" warning banner.
# The bot exports state every 5 seconds by default, so 60s is a safe
# threshold that tolerates brief pauses.
STALE_SECONDS=60
